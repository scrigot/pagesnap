{
  "manifest_version": 3,
  "name": "PageSnap",
  "short_name": "PageSnap",
  "version": "0.1.0",
  "description": "Capture the entire scrollable page as one PNG and copy it to the clipboard. Local only.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "clipboardWrite", "storage"],
  "optional_permissions": ["downloads"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "PageSnap: capture full page",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_ui": { "page": "options/index.html", "open_in_tab": true },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Capture the full page"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
